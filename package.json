{
  "name": "yaml-language-server",
  "description": "YAML language server",
  "version": "1.25.0",
  "author": "Red Hat",
  "license": "MIT",
  "contributors": [
    {
      "name": "Muthurajan Sivasubramanian",
      "email": "msivasub@redhat.com"
    },
    {
      "name": "Google LLC"
    }
  ],
  "type": "module",
  "bin": {
    "yaml-language-server": "bin/yaml-language-server"
  },
  "main": "./out/server/src/index.js",
  "l10n": "./l10n",
  "keywords": [
    "yaml",
    "LSP"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redhat-developer/yaml-language-server.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@vscode/l10n": "^0.0.18",
    "ajv": "^8.17.1",
    "ajv-draft-04": "^1.0.0",
    "ajv-i18n": "^4.2.0",
    "jsonc-parser": "^3.3.1",
    "picomatch": "^4.0.4",
    "prettier": "^3.8.1",
    "request-light": "^0.5.7",
    "vscode-languageserver": "^9.0.0",
    "vscode-languageserver-textdocument": "^1.0.1",
    "vscode-languageserver-types": "~3.17.5",
    "vscode-uri": "^3.0.2",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@microsoft/eslint-formatter-sarif": "^3.0.0",
    "@types/chai": "^4.2.12",
    "@types/node": "22.x",
    "@types/picomatch": "^4.0.3",
    "@types/sinon": "^22.0.0",
    "@types/sinon-chai": "^3.2.5",
    "@typescript-eslint/parser": "^8.59.4",
    "c8": "^12.0.0",
    "chai": "^4.2.0",
    "eslint": "^10.0.0",
    "eslint-plugin-import-x": "^4.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "rimraf": "^3.0.2",
    "sinon": "^22.1.0",
    "sinon-chai": "^3.5.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.59.4"
  },
  "scripts": {
    "clean": "rimraf out/server",
    "compile": "tsc -p .",
    "watch": "tsc --watch -p .",
    "test": "npm run compile && node --enable-source-maps --test out/server/test/*.test.js",
    "coveralls": "c8 --reporter=lcov --reporter=text npm test",
    "lint": "eslint --max-warnings 0",
    "lint-ci": "eslint --max-warnings 0 -f @microsoft/eslint-formatter-sarif -o eslint-result.sarif",
    "prettier-fix": "npm run prettier --write .",
    "build": "npm run clean && npm run lint && npm run compile",
    "check-dependencies": "node ./scripts/check-dependencies.js",
    "pull-remote": "git pull https://github.com/redhat-developer/yaml-language-server.git main"
  },
  "c8": {
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "**/*.d.ts"
    ],
    "all": true,
    "exclude-after-remap": true
  }
}
